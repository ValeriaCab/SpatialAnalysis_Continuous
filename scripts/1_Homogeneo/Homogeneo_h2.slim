// First map (Homogeneous)
defineConstant("mapValuesHomo", matrix(c(0, 0, 0, 0), ncol=2)); 
p1.defineSpatialMap("MAP", "xy", mapValuesHomo, interpolate=T,
valueRange=c(0.0, 0.0), colors=c("yellow","yellow"));

//new_environment = 0;
//flag_coalesc = 0;

catn("\n---START SIMULATION---");
catn("\nPopulation size Generation 0: " + p1.individualCount + "\n");
}

first() {

    // adult movement (reflecting boundaries, Gaussian kernel with sigma_V)
	if (SV > 0) {
		p1.deviatePositions(p1.individuals, "reflecting", INF, "n", SV);
	}
    i2.evaluate(p1); // Call to spatial interaction function
}

reproduction() {
//individual selection of a close mate(SM)
mate = i2.drawByStrength(individual, 1); 

// If a person found a mate, then:
if (mate.size())
    //Offspring follow a Poisson distribution with mean FECUN:
    subpop.addCrossed(individual, mate, count=rpois(1, FECUN));
}

// 1 Early events: -------------------------------------------------------------------

early() {

i1.evaluate(p1);

// Disperse offspring
offspring = p1.subsetIndividuals(maxAge=0);
p1.deviatePositions(offspring, "reprising", INF, "n", SD);

// Phenotype
inds = sim.subpopulations.individuals;    // Individual vector
additive = inds.sumOfMutationsOfType(m2); // Sum of Mutations with additive effect
V_A = sd(additive)^2;                     // Additive genetic variance
V_E = (V_A - h2 * V_A) / h2;              // Environmental variance
env = rnorm(size(inds), 0.0, sqrt(V_E));  // Environmental effects
phenotypes = additive + env;              // Total phenotype
defineGlobal("phenotypes", phenotypes);

// Get optimal fitness value from the current map
location = inds.spatialPosition[rep(c(T, T), inds.size())];
optimum = p1.spatialMapValue("MAP", location);
inds.color = p1.spatialMapColor("MAP", phenotypes); 

// Fitness calculation
density = i1.localPopulationDensity(inds);
inds.fitnessScaling = BASAL + ((exp(-(((phenotypes - optimum)^2) / ((2) * (SW^2))))) / (1 + RHO * density));

}

// Guardar árboles al final
late() {
    if (flag_coalesc == 0){
        if (sim.treeSeqCoalesced()){
        coalesc_gen = community.tick;
        catn(coalesc_gen + ": COALESCED");
        writeFile(RUNDIR + "/coales." + RUNID + ".txt",
        coalesc_gen + ": COALESCED\n", append=T);
        sim.treeSeqOutput(RUNDIR + "/trees." + RUNID + ".trees");
        flag_coalesc = 1;
    }
}
}
// 2 Final events ---------------------------------------------------------------------------
FINISH late() {

if (!sim.treeSeqCoalesced()) {
    catn(community.tick + ": NO COALESCED");
    writeFile(RUNDIR + "/coales." + RUNID + ".txt",
            community.tick + ": NO COALESCED\n", append=T);
    sim.treeSeqOutput(RUNDIR + "/trees." + RUNID + ".trees");
}
i1.evaluate(p1);

inds = sim.subpopulations.individuals;
additive = inds.sumOfMutationsOfType(m2); // Sum of Mutations with additive effect
V_A = sd(additive)^2;                     // Additive genetic variance
V_E = (V_A - h2 * V_A) / h2;              // Environmental variance
env = rnorm(size(inds), 0.0, sqrt(V_E));  // Environmental effects
phenotypes = additive + env;              // Total phenotype
location = inds.spatialPosition[rep(c(T, T), inds.size())];
optimum = p1.spatialMapValue("MAP", location);

// Fitness calculation
density = i1.localPopulationDensity(inds);
inds.fitnessScaling = BASAL + ((exp(-(((phenotypes - optimum)^2) / ((2) * (SW^2))))) / (1 + RHO * density));

writeFile(RUNDIR + "/Opt_Phen." + RUNID + ".csv", "IND_ID\tOpt\tPhen\tAbsErr\tFitness\tdensity\n", append=F); 


   for (j in seqAlong(inds)) {
        line_opt = paste(c(
                        inds[j].index + 1,
                        optimum[j],
                        phenotypes[j],
                        abs(phenotypes[j] - optimum[j]),    
                        inds[j].fitnessScaling,
                        density[j]
        ), sep="\t");

        writeFile(RUNDIR + "/Opt_Phen." + RUNID + ".csv", line_opt , append=T);
}


// Analysis 1
// Frequency vs Mutation Effect
qtls = sim.mutationsOfType(m2); // Population QTLs
f = sim.mutationFrequencies(NULL, qtls); // Frequency
id = qtls.id;                            // QTL ID
s = qtls.selectionCoeff;                 // Efect size
p = qtls.position;
o = qtls.originTick;
indices = order(f, F);                   // Frequency vector from lowest to highest

writeFile(RUNDIR + "/Freq_vs_MutEffect." + RUNID + ".csv", "QTL_ID\tFreq\tMutEffect\n", append=F); 
writeFile(RUNDIR + "/Summary_QTLs." + RUNID + ".csv", "QTL_ID\tPosInGenome\tMutEffect\tFreq\tOriginTick\n" , append=F);
writeFile(RUNDIR + "/Mutations_Carriers." + RUNID + ".csv", "QTL_ID\tPosInGenome\tIND_ID\tPosInd_X\tPosInd_Y\tCopies\tGenomes\n" , append=F);

for (i in indices) {
    mut = qtls[i];

    line = paste(c(id[i], f[i], s[i]), sep="\t");
    writeFile(RUNDIR + "/Freq_vs_MutEffect." + RUNID + ".csv", line , append=T);

    line_two = paste(c(id[i], p[i], s[i], f[i], o[i]), sep = "\t");
    writeFile(RUNDIR + "/Summary_QTLs." + RUNID + ".csv", line_two , append=T);
    
    for (ind in inds){
        copies = sum(ind.genomes.containsMutations(mut));  
        if (copies == 0){
            next;
        }
        pos = ind.spatialPosition;
        x = pos[0];
        y = pos[1];

        genomes = ind.genomes.size();
        
        line_three = paste(c(id[i], p[i], ind.index+1, x, y, copies, genomes), sep = "\t"); 
        writeFile(RUNDIR + "/Mutations_Carriers." + RUNID + ".csv", line_three , append=T);
    }         
}

// Analysis 2
// Phenotype Value vs Region
for (region in REGIONS_SET){
div = WIDTH / region ; // Division of regions
regions_vec = NULL;

writeFile(RUNDIR + "/FST_" + region + "." + RUNID + ".csv", "Region\tRegion\tFst\n" , append=F);
writeFile(RUNDIR + "/Phen_vs_Regions_" + region + "." + RUNID + ".csv", "IND_ID\tPosInd_X\tPosInd_Y\tPhenValue\tRegion\n", append=T);

catn("\nREGIONES");
freq_mean = c();

// matrix: rows = QTLs, columns = regions
freq_matrix = matrix(rep(0.0, size(qtls) * region), size(qtls), region);
region_index = 0;
num_ind_region = c();

//Loop that traverses the regions of the map

for (index in 0:(region-1)){
    sum_Freq_MutEfe = 0.0;
    start = index * div;
    end = (index + 1) * div;

    sample_region = inds[inds.x >= start & inds.x < end]; //muestra de ind en c/region
    num_ind_region = c(num_ind_region, size(sample_region)); //Numero de individuos en c/region
    
     catn("Region "+ (index + 1) + ": [" + start + "," + end + "] → "
           +  num_ind_region[index] + " individuals.");
    
     //Phenotype value for each individual by region
     for (i in sample_region) {
        pheno_value = phenotypes[i.index];
        pos = i.spatialPosition;
        x = pos[0];
        y = pos[1];
        
        line = paste(i.index+1,x,y,pheno_value, index + 1, sep="\t");
        writeFile(RUNDIR + "/Phen_vs_Regions_" + region + "." + RUNID + ".csv", line, append=T);

    } 
    // Frequency of each QTLS by region
    region_index = index + 1;
    freqs = c();   // frequency vector
    for (mut in qtls) {
         count = 0;
         total_genomes = 2 * num_ind_region[index];  // diploides

        for (ind in sample_region) {
            if (ind.genome1.containsMutations(mut)){
                count = count + 1;
            }
            if (ind.genome2.containsMutations(mut)){
                count = count + 1;
            }
        }
        freq = count / total_genomes;        // escalar
        freqs = c(freqs, freq);

        Mut_Efec = mut.selectionCoeff;        // escalar

        sum_Freq_MutEfe = sum_Freq_MutEfe + (Mut_Efec * freq);
     }

    // save this region as a column
    freq_matrix[, index] = freqs;
    catn("Region: " + region_index +
         " → Sum of Freq * Mutation Efect: " + sum_Freq_MutEfe + "\n");
}//(for) regions

catn("\nFinal population size: " + p1.individualCount);
catn("\nFrequency Matrix of QTLs x Region");
print(freq_matrix); // QTL Matrix x Region

//FST Differences between allele frequencies in populations
catn("\nCOMPARISONS BETWEEN REGIONS");

// QTL by QTL
// Matrices for sums between pairs of regions
sum_num_matrix = matrix(rep(0.0, region * region), nrow=region, ncol=region);
sum_den_matrix = matrix(rep(0.0, region * region), nrow=region, ncol=region);
for (qtl_index in 0:(size(qtls)-1)) {
    for (i in 0:(region-2)) {
          for (j in (i+1):(region-1)) {

             pop_i = freq_matrix[qtl_index, i];
             pop_j = freq_matrix[qtl_index, j];

             size_i = num_ind_region[i];
             size_j = num_ind_region[j];

             // numerador Hudson
             numerator = (pop_i - pop_j)^2 - (pop_i * (1 - pop_i))/(size_i - 1) - (pop_j * (1 - pop_j))/(size_j - 1);

             // denominador Hudson
             denominator = pop_i * (1 - pop_j) + pop_j * (1 - pop_i);

            catn("QTL " + qtl_index +
                 " Regions " + (i+1) + "-" + (j+1) +
                 " → Num=" + numerator +
                 " Den=" + denominator);

            // Sum
            sum_num_matrix[i, j] = sum_num_matrix[i, j] + numerator;
            sum_den_matrix[i, j] = sum_den_matrix[i, j] + denominator;
       }
   }
   catn("\n");
}
catn("\nEnd comparison");
catn("\nSUM OF ALL REGION PAIRS\n");

for (i in 0:(region-2)) {
for (j in (i+1):(region-1)) {

    if (sum_den_matrix[i,j] > 0.0) {
        fst = sum_num_matrix[i,j] / sum_den_matrix[i,j];
    } else {
        fst = NA;
    }

    catn("Regions " + (i+1) + "–" + (j+1) + "  Hudson Fst = " + fst);

    line_four = paste(c(i+1, j+1, fst), sep="\t");
    writeFile(RUNDIR + "/FST_" + region + "." + RUNID + ".csv",
              line_four, append=T);
}
}
} //for regions   
catn("\nFINISH");
}//finish late






